generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model Apps {
    app_id               Int     @id @default(autoincrement())
    port                 String
    app_name             String  @unique
    app_desc             String
    app_parameters       Json
    requires_dedicated_ws Boolean
    category      String @default("Other Apps")

    app_instance App_instance[]

    @@map("apps")
}

model App_instance {
    id           Int    @id @default(autoincrement())
    guid         String 
    machine_uuid String
    rto_code     String
    ip_address   String
    app_id       Int

    apps Apps @relation(fields: [app_id], references: [app_id])

    @@map("app_instance")
}
